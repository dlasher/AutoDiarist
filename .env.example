# Copy this file to .env before starting the service.
# GPU inference defaults are appropriate for NVIDIA Turing (compute
# capability 7.5, e.g. the T400 4GB the spike validated on).
HOST_PORT=8000
MOCK_PIPELINE=0

# --- CrispASR backend contract (pipeline/transcribe.py) --------------------
# Engine CLI from the crispasr v0.8.43 CUDA prebuilt, baked into the image.
CRISPASR_BIN=/opt/crispasr/crispasr
# Canonical Nemotron 3.5 ASR streaming 0.6B Q4_K GGUF (cstr repo, sha256
# 22480dd2...). Set empty to fall back to engine auto-download into
# CRISPASR_CACHE_DIR instead of the baked-in copy.
GGUF_MODEL=/opt/models/nemotron-3.5-asr-streaming-0.6b-q4_k.gguf
# Where the foxnose diarizer embedder (--diarize-embedder auto) is cached.
CRISPASR_CACHE_DIR=/var/cache/crispasr
# Directory holding libcudart.so.13 / libcublas.so.13 (apt cuda-cudart-13-0
# libcublas-13-0). Without them crispasr silently runs on CPU (~11x slower).
CRISPASR_LIB_DIR=/usr/local/cuda-13.0/targets/x86_64-linux/lib
# Pinned CUDA backend; the adapter probes `crispasr --version` and fails the
# job fast when cuda is not a registered backend. Change only to force CPU
# debugging.
CRISPASR_GPU_BACKEND=cuda
# Speaker diarization: foxnose (default, globally-stable IDs), ecapa,
# sherpa, sortformer, none.
DIAR_METHOD=foxnose
# Per-job VRAM ceiling in MiB (3.5 GiB, card t_95726260). The engine
# auto-slices audio into ~30 s windows internally; spike measured 1085 MiB
# peak over a full 39-minute file. Exceeding the limit raises
# TranscriptionOOM instead of thrashing the card.
VRAM_LIMIT_MIB=3584
# Wall-clock budget per crispasr invocation.
CRISPASR_TIMEOUT_SECONDS=1800

# --- Bounded-memory pipeline settings ---------------------------------------
# The CrispASR backend runs whole-file in a single invocation (engine-managed
# ~30 s chunking), so these no longer bound VRAM; they only apply to the
# pipeline.chunking utility if used directly. Kept for compatibility.
CHUNK_SECONDS=180
OVERLAP_SECONDS=30
MAX_UPLOAD_BYTES=524288000
SPELL_CHECK=1

# Queue admission limits (card t_daebf369, V1.5 change card t_82bfbc15).
# POST /v1/jobs returns 503 + Retry-After past MAX_QUEUE_DEPTH queued
# jobs — the ONLY rejection path: a session may hold any number of active
# jobs (the old MAX_JOBS_PER_SESSION / 429 quota is deprecated and
# ignored; setting it logs a startup warning). Session identity comes from
# this header when present (default: bearer token in Authorization), else
# the server-issued autodiarist_session cookie, else client IP, else a
# shared 'anonymous' bucket.
MAX_QUEUE_DEPTH=50
RETRY_AFTER_SECONDS=30
# Fair-share scheduling (card t_4b40acfd): the worker claims the next job
# round-robin across sessions (FIFO within each session), and one session may
# hold at most this many concurrently PROCESSING jobs. Values < 1 or
# unparseable warn and clamp to 1. queue_position reports the rank in this
# fair execution order — no longer the raw admission order.
MAX_PROCESSING_PER_SESSION=1
# Queue-aware wait estimates (card t_b3ae9366): estimated GPU seconds per
# second of audio, used for estimated_wait_seconds /
# estimated_completion_at on queued jobs (202 + every poll). The default
# 0.185 was MEASURED on the T400 rig (39-min audio took 423-434 s wall on
# CUDA) and is hardware-specific — re-derive it for your GPU per CONFIG.md.
# These are linear-model estimates, never guarantees. Exact 0 disables the
# ETA fields; negative/non-numeric warn at boot and fall back to the default.
PROCESSING_SECONDS_PER_AUDIO_SECOND=0.185
# Duration substituted in the ETA prefix sum for a queued job ahead whose
# ffprobe duration could not be read at admission (never for your own job:
# unknown own duration = no estimate).
AUDIO_DURATION_FALLBACK_SECONDS=300
SESSION_HEADER=Authorization
# Set to 0 to admit jobs without processing them (ops hold-valve / tests).
QUEUE_WORKER_ENABLED=1

# Pipe-delimited regular expressions. Leave blank to use built-in patterns.
SELF_ID_PATTERNS=
# Job retention (card t_5e6200fc): finished job dirs (done/failed/cancelled)
# whose status.json is older than this many days are deleted at boot and
# hourly. The live queued/processing pair is never age-swept. 0 disables
# age-based expiry entirely.
RETENTION_DAYS=30
# Disk-pressure eviction: when free space on the JOBS_DIR filesystem drops
# below this many MiB, job dirs are evicted oldest-first until the watermark
# recovers. A 'processing' job is never evicted. 0 disables eviction.
DISK_MIN_FREE_MIB=8192
# How often (seconds) the disk-pressure check runs; it also runs once at boot.
DISK_CHECK_INTERVAL_SECONDS=300

# Optional vocabulary override used by spell-checking.
VOCAB_PATH=
