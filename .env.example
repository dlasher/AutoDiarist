# OPTIONAL overrides. A fresh clone needs NO .env at all: both compose
# files carry inline ${VAR:-default} values and no env_file reference, so
# `docker compose up` / `docker compose -f docker-compose.amd.yml up`
# work with zero edits (packaging card t_f82ad22a). Copy this file to
# .env ONLY when you want to override a knob — docker compose reads it
# automatically from the project directory.
# GPU inference defaults are appropriate for NVIDIA Turing (compute
# capability 7.5, e.g. the T400 4GB the spike validated on) as a starting
# point; on AMD/Vulkan see docker-compose.amd.yml (it mirrors the proven
# bring-up pins). Host-specific device GIDs NEVER belong in any tracked
# file or here: AMD device access is granted host-side via
# scripts/vulkan-host-setup.sh (setfacl for uid 10001 is the primary
# path), not via compose.
HOST_PORT=8000
MOCK_PIPELINE=0

# --- CrispASR backend contract (pipeline/transcribe.py) --------------------
# Engine CLI from the crispasr v0.8.43 CUDA prebuilt, baked into the image.
CRISPASR_BIN=/opt/crispasr/crispasr
# Canonical Nemotron 3.5 ASR streaming 0.6B Q4_K GGUF (cstr repo, sha256
# 22480dd2...). Set empty to fall back to engine auto-download into
# CRISPASR_CACHE_DIR instead of the baked-in copy.
GGUF_MODEL=/opt/models/nemotron-3.5-asr-streaming-0.6b-q4_k.gguf
# Where the foxnose diarizer embedder (--diarize-embedder auto) is cached.
CRISPASR_CACHE_DIR=/var/cache/crispasr
# Directory holding libcudart.so.13 / libcublas.so.13 (apt cuda-cudart-13-0
# libcublas-13-0). Without them crispasr silently runs on CPU (~11x slower).
CRISPASR_LIB_DIR=/usr/local/cuda-13.0/targets/x86_64-linux/lib
# Pinned CUDA backend; the adapter probes `crispasr --version` and fails the
# job fast when cuda is not a registered backend. Change only to force CPU
# debugging.
CRISPASR_GPU_BACKEND=cuda
# Speaker diarization: sherpa (default since card t_5a287979 -- external
# sherpa-onnx subprocess: segmentation + speaker embedding + clustering;
# the only engine path that keeps multi-speaker panels apart), ecapa,
# foxnose (fast; collapses 5-speaker panel audio to 1 via its BIC
# single-speaker veto), sortformer, none.
DIAR_METHOD=sherpa
# The sherpa/ecapa methods shell out to sherpa-onnx and REQUIRE both ONNX
# models; the service refuses to start without them (no silent
# single-speaker degradation). The image bakes these paths (see Dockerfile
# and README "Diarization models").
SHERPA_SEGMENT_MODEL=/opt/models/sherpa-onnx-reverb-diarization-v1.onnx
SHERPA_EMBEDDING_MODEL=/opt/models/3dspeaker_speech_eres2net_base_sv_zh-cn_3dspeaker_16k.onnx
# Wrapper that injects --clustering.cluster-threshold into the sherpa CLI
# (the crispasr engine has no flag for it; it decides how many speakers
# FastClustering emits: larger -> fewer). Empty = look for the bare
# sherpa-onnx-offline-speaker-diarization binary on PATH.
SHERPA_BIN=/opt/sherpa/sherpa-diarization-wrapper
SHERPA_CLUSTER_THRESHOLD=0.40
# Ceiling on distinct diarization speaker labels (card t_38e52d89; the
# NASA Q&A fixture exploded to 100 labels against a 6-7-speaker
# reference). The wrapper counts the auto-threshold pass's labels and,
# ONLY when they exceed this ceiling, re-runs clustering forcing
# exactly DIARIZATION_MAX_SPEAKERS clusters (strip-then-inject, since the
# engine's own --clustering.num-clusters=0 would otherwise win). The Q&A
# fixture measures 7 speakers after the cap (reference 6-7); audio
# already at or below the ceiling is untouched. Meetings with >10
# participants are not expected, so 8 is a safe default. RAISE it for
# larger rooms; DIARIZATION_MAX_SPEAKERS=0 disables the ceiling
# (pre-card behaviour). See autodiarist-speaker-count-ceiling.md.
DIARIZATION_MAX_SPEAKERS=8
# --- diarization threading (card t_3cb8f97c) --------------------------------
# The sherpa CLI runs its segmentation + embedding networks on ONE thread by
# default, and diarization is ~80% of a job's wall time. Measured on the
# 4-core NVIDIA box (isolated sherpa stage, 137.5 s clip): 58.3 s @1 thread
# -> 32.3 s @2 -> 20.5 s @4 (2.85x) with the SAME speaker count at every
# count, and it REGRESSES above the core count (8 threads = 68 s, worse than
# 1) — which is why NOTHING is hardcoded as the default. Leave both knobs
# EMPTY for the safe auto value: the wrapper computes
#   threads = min(max(1, cores // MAX_PROCESSING_GLOBAL), SHERPA_MAX_THREADS)
# (cores = container-visible cores — the compose files set no CPU limits —
# and MAX_PROCESSING_GLOBAL is the queue-worker count, listed below).
# Shipped N=1
# gets the full win; N=3 on this box drops to 1 thread per job by itself, so
# total demand never exceeds the core count and the default is never worse
# than the old single-thread behaviour. The resolved value is logged to each
# job's stderr. SHERPA_NUM_THREADS pins an explicit count instead (valid
# counts are passed to BOTH networks, clamped only down to the core count);
# SHERPA_MAX_THREADS raises the AUTO ceiling on big boxes without a rebuild
# (the AMD host has 12 cores; its 8-vs-10-vs-12 sweep is pending). Both knobs
# are listed in both compose files, so `SHERPA_NUM_THREADS=2 docker compose
# up -d` works from the host — no rebuild, no restart needed if you use
# `docker compose exec -e`. Full mechanics: CONFIG.md "Diarization
# threading".
# SHERPA_NUM_THREADS=
# SHERPA_MAX_THREADS=
# Per-job VRAM ceiling in MiB (3.5 GiB, card t_95726260). The engine
# auto-slices audio into ~30 s windows internally; spike measured 1085 MiB
# peak over a full 39-minute file. Exceeding the limit raises
# TranscriptionOOM instead of thrashing the card.
VRAM_LIMIT_MIB=3584
# HARD wall-clock budget for the whole job (not an idle timeout): when it
# expires the engine's process group is killed and the job reports failed.
# The default is fine for short inputs but TOO LOW for long ones — a
# 140-minute file needs ~83 min on a 4-core host, ~38 min on a many-core host.
# Override for long jobs: CRISPASR_TIMEOUT_SECONDS=10800
CRISPASR_TIMEOUT_SECONDS=1800

# --- Bounded-memory pipeline settings ---------------------------------------
# The CrispASR backend runs whole-file in a single invocation (engine-managed
# ~30 s chunking), so these no longer bound VRAM; they only apply to the
# pipeline.chunking utility if used directly. Kept for compatibility.
CHUNK_SECONDS=180
OVERLAP_SECONDS=30
MAX_UPLOAD_BYTES=524288000
# Domain vocabulary spell check (card t_72405565): ON by default — set 0/off
# to disable. VOCAB_PATH (unset here) would override the image's baked-in
# /app/vocab.txt NASA/SEWP domain vocabulary.
SPELL_CHECK=1

# Queue admission limits (card t_daebf369, V1.5 change card t_82bfbc15).
# POST /v1/jobs returns 503 + Retry-After past MAX_QUEUE_DEPTH queued
# jobs — the ONLY rejection path: a session may hold any number of active
# jobs (the old MAX_JOBS_PER_SESSION / 429 quota is deprecated and
# ignored; setting it logs a startup warning). Session identity comes from
# this header when present (default: bearer token in Authorization), else
# the server-issued autodiarist_session cookie, else client IP, else a
# shared 'anonymous' bucket.
MAX_QUEUE_DEPTH=50
RETRY_AFTER_SECONDS=30
# Fair-share scheduling (card t_4b40acfd): the worker claims the next job
# round-robin across sessions (FIFO within each session), and one session may
# hold at most this many concurrently PROCESSING jobs. Values < 1 or
# unparseable warn and clamp to 1. queue_position reports the rank in this
# fair execution order — no longer the raw admission order.
MAX_PROCESSING_PER_SESSION=1
# Global concurrency (card t_dbad2235): number of queue workers processing
# jobs SIMULTANEOUSLY. Default 1 = today's serial behaviour; opt in per host
# from MEASUREMENT, not a guess (measured NVIDIA T400: N=3 sustains 3/3
# engines at 3207/4096 MiB of the 4096 MiB card; N=4 kills the 4th engine
# with `sched alloc encoder graph failed` while the other 3 survive — the
# service marks that job failed and keeps serving). Values < 1 or
# unparseable warn and clamp to 1. Under N>1 the nvidia-smi sampler sees the
# card TOTAL, so the VRAM ceiling a job is checked against becomes
# VRAM_LIMIT_MIB x N (the per-job share scaled to the fleet); on AMD the
# sampler has no nvidia-smi and VRAM_LIMIT_MIB is inert either way.
# The knob MUST be inside the compose `environment:` block to reach the
# container — Docker Compose does not pass arbitrary host env vars in.
MAX_PROCESSING_GLOBAL=1
# Queue-aware wait estimates (card t_b3ae9366): estimated GPU seconds per
# second of audio, used for estimated_wait_seconds /
# estimated_completion_at on queued jobs (202 + every poll). The default
# 0.185 was MEASURED on the T400 rig (39-min audio took 423-434 s wall on
# CUDA) and is hardware-specific — re-derive it for your GPU per CONFIG.md.
# These are linear-model estimates, never guarantees. Exact 0 disables the
# ETA fields; negative/non-numeric warn at boot and fall back to the default.
PROCESSING_SECONDS_PER_AUDIO_SECOND=0.185
# Duration substituted in the ETA prefix sum for a queued job ahead whose
# ffprobe duration could not be read at admission (never for your own job:
# unknown own duration = no estimate).
AUDIO_DURATION_FALLBACK_SECONDS=300
SESSION_HEADER=Authorization
# Set to 0 to admit jobs without processing them (ops hold-valve / tests).
QUEUE_WORKER_ENABLED=1

# Pipe-delimited regular expressions. Leave blank to use built-in patterns.
SELF_ID_PATTERNS=
# Job retention (card t_5e6200fc): finished job dirs (done/failed/cancelled)
# whose status.json is older than this many days are deleted at boot and
# hourly. The live queued/processing pair is never age-swept. 0 disables
# age-based expiry entirely.
RETENTION_DAYS=30
# Disk-pressure eviction: when free space on the JOBS_DIR filesystem drops
# below this many MiB, job dirs are evicted oldest-first until the watermark
# recovers. A 'processing' job is never evicted. 0 disables eviction.
DISK_MIN_FREE_MIB=8192
# How often (seconds) the disk-pressure check runs; it also runs once at boot.
DISK_CHECK_INTERVAL_SECONDS=300

# Optional vocabulary override used by spell-checking.
VOCAB_PATH=
